# -----------------------------------------------------------------------------
# Google App Engine 部署忽略配置 (.gcloudignore)
# -----------------------------------------------------------------------------

# 忽略 Git 自身的版本控制数据（防止小文件过多超限）
.git/
.gitignore

# 忽略本地开发测试脚本及测试套件
tests/
availability_g4f/

# 虚拟环境文件夹（含有数千个依赖碎片文件，必须忽略）
.venv/
venv/
ENV/
env/

# Python 缓存和编译文件
__pycache__/
*.pyc
*.pyo
*.pyd

# 操作系统产生的临时隐藏文件
.DS_Store
Thumbs.db

# 环境变量本地配置文件（包含敏感或本地端口配置）
.env
.flaskenv

# IDE 和编辑器本地配置
.vscode/
.idea/

# 测试生成的结果日志
provider_test_results*.txt
image_provider_test_results.txt

# 服务商与模型本地扫描的缓存文件
available_providers_models.txt
available_image_providers_models.txt
available_free_image_providers.txt

# 注意：切勿在此处添加 generated_media/ 
# 因为项目依赖该本地目录进行图片持久化存储与历史回溯